{
  "name": "forge-rovo-guardrail-project",
  "version": "0.0.0",
  "private": true,
  "description": "a sample Forge-based Rovo Agent that checks project health",
  "license": "Apache-2.0",
  "main": "index.js",
  "scripts": {
    "actiontypes": "tsx ./scripts/actiontypes.ts && biome format --write",
    "build": "tsc",
    "changelog": "git cliff",
    "check": "biome check --write",
    "clean": "rm -rf ./dist",
    "eval": "promptfoo eval",
    "format": "biome format --write",
    "lint": "biome lint",
    "test": "vitest",
    "view": "promptfoo view"
  },
  "dependencies": {
    "@forge/api": "^8.1",
    "elegant-queue": "^1.0",
    "jmespath": "^0.16",
    "yaml": "^2.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/jmespath": "^0.15",
    "@types/node": "22",
    "promptfoo": "^0.123",
    "tsx": "^4.23",
    "typescript": "^5.9.3",
    "vitest": "^5.0"
  },
  "engines": {
    "node": "24.21.0"
  }
}
